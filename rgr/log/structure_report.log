 contracts          | contracts_pk  | CREATE UNIQUE INDEX contracts_pk ON public.contracts USING btree (contr_id)
 contracts          | contracts_uk  | CREATE UNIQUE INDEX contracts_uk ON public.contracts USING btree (contr_number)
 employees          | employees_pk  | CREATE UNIQUE INDEX employees_pk ON public.employees USING btree (emp_id)
 passages           | passages_pk   | CREATE UNIQUE INDEX passages_pk ON public.passages USING btree (pass_id)
 passages           | passages_uk   | CREATE UNIQUE INDEX passages_uk ON public.passages USING btree (pass_plate_raw, pass_time, pass_direction)
 payments           | payments_pk   | CREATE UNIQUE INDEX payments_pk ON public.payments USING btree (pay_id)
 payments           | payments_uk   | CREATE UNIQUE INDEX payments_uk ON public.payments USING btree (pay_receipt_no)
 places             | places_pk     | CREATE UNIQUE INDEX places_pk ON public.places USING btree (pl_id)
 places             | places_uk     | CREATE UNIQUE INDEX places_uk ON public.places USING btree (pl_sector, pl_number)
 tariffs            | tariffs_pk    | CREATE UNIQUE INDEX tariffs_pk ON public.tariffs USING btree (tar_id)
 tariffs            | tariffs_uk    | CREATE UNIQUE INDEX tariffs_uk ON public.tariffs USING btree (tar_name, tar_cat_id, tar_date_from)
 vehicle_categories | categories_pk | CREATE UNIQUE INDEX categories_pk ON public.vehicle_categories USING btree (cat_id)
 vehicle_categories | categories_uk | CREATE UNIQUE INDEX categories_uk ON public.vehicle_categories USING btree (cat_name)
 vehicles           | vehicles_pk   | CREATE UNIQUE INDEX vehicles_pk ON public.vehicles USING btree (veh_id)
 vehicles           | vehicles_uk   | CREATE UNIQUE INDEX vehicles_uk ON public.vehicles USING btree (veh_plate)
