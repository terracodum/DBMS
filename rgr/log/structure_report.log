WHERE  schemaname = 'public'
ORDER  BY tablename, indexname;
      Таблица       |    Индекс     |                                                Определение                                                 
--------------------+---------------+------------------------------------------------------------------------------------------------------------
 clients            | clients_pk    | CREATE UNIQUE INDEX clients_pk ON public.clients USING btree (cl_id)
