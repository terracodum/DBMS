SELECT c.relname AS "Таблица",
       obj_description(c.oid) AS "Комментарий"
FROM   pg_class c
JOIN   pg_namespace n ON n.oid = c.relnamespace
WHERE  n.nspname = 'public' AND c.relkind = 'r'
ORDER  BY c.relname;
      Таблица       |                             Комментарий                             
--------------------+---------------------------------------------------------------------
 clients            | Клиенты автостоянки (физические и юридические лица)
 contracts          | Договоры с клиентами
 employees          | Сотрудники автостоянки
 passages           | Журнал проездов: электронная регистрация по государственному номеру
 payments           | Квитанции об оплате (допускается частичная оплата договора)
 places             | Машино-места
 tariffs            | Тарифы на услуги хранения
 vehicle_categories | Справочник категорий транспортных средств
 vehicles           | Транспортные средства клиентов
(9 �����)

SELECT table_name  AS "Таблица",
       ordinal_position AS "N",
       column_name AS "Поле",
       CASE WHEN character_maximum_length IS NOT NULL
                 THEN data_type || '(' || character_maximum_length || ')'
            WHEN numeric_precision IS NOT NULL AND data_type = 'numeric'
                 THEN data_type || '(' || numeric_precision || ',' || numeric_scale || ')'
            ELSE data_type END AS "Тип данных",
       is_nullable AS "NULL?",
       column_default AS "По умолчанию"
FROM   information_schema.columns
WHERE  table_schema = 'public'
ORDER  BY table_name, ordinal_position;
