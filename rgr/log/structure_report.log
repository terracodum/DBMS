SELECT conrelid::regclass AS "Таблица",
       conname            AS "Имя ограничения",
       CASE contype WHEN 'p' THEN 'PRIMARY KEY'
                    WHEN 'u' THEN 'UNIQUE'
                    WHEN 'c' THEN 'CHECK'
                    WHEN 'f' THEN 'FOREIGN KEY'
                    WHEN 'x' THEN 'EXCLUDE' END AS "Тип",
       pg_get_constraintdef(oid) AS "Определение"
FROM   pg_constraint
WHERE  connamespace = 'public'::regnamespace
ORDER  BY 3, 1, 2;
      Таблица       |   Имя ограничения   |     Тип     |                                                    Определение                                                    
--------------------+---------------------+-------------+-------------------------------------------------------------------------------------------------------------------
 vehicle_categories | categories_ck_coef  | CHECK       | CHECK ((cat_coef > (0)::numeric))
 clients            | clients_ck_discount | CHECK       | CHECK (((cl_discount >= 0) AND (cl_discount <= 30)))
 clients            | clients_ck_type     | CHECK       | CHECK ((cl_type = ANY (ARRAY['Ф'::bpchar, 'Ю'::bpchar])))
 employees          | employees_ck_chief  | CHECK       | CHECK (((emp_chief_id IS NULL) OR (emp_chief_id <> emp_id)))
 vehicles           | vehicles_ck_plate   | CHECK       | CHECK (((length((veh_plate)::text) >= 8) AND (length((veh_plate)::text) <= 9)))
 places             | places_ck_level     | CHECK       | CHECK (((pl_level >= '-2'::integer) AND (pl_level <= 10)))
 places             | places_ck_number    | CHECK       | CHECK ((pl_number > 0))
 places             | places_ck_status    | CHECK       | CHECK ((pl_status = ANY (ARRAY['свободно'::text, 'занято'::text, 'ремонт'::text])))
 tariffs            | tariffs_ck_dates    | CHECK       | CHECK (((tar_date_to IS NULL) OR (tar_date_to >= tar_date_from)))
 tariffs            | tariffs_ck_period   | CHECK       | CHECK ((tar_period = ANY (ARRAY['час'::text, 'сутки'::text, 'месяц'::text])))
 tariffs            | tariffs_ck_price    | CHECK       | CHECK ((tar_price > (0)::numeric))
 contracts          | contracts_ck_amount | CHECK       | CHECK ((contr_amount >= (0)::numeric))
 contracts          | contracts_ck_dates  | CHECK       | CHECK (((contr_end IS NULL) OR (contr_end >= contr_start)))
 contracts          | contracts_ck_signed | CHECK       | CHECK ((contr_date <= contr_start))
 contracts          | contracts_ck_status | CHECK       | CHECK ((contr_status = ANY (ARRAY['оформлен'::text, 'действующий'::text, 'завершён'::text, 'расторгнут'::text])))
 payments           | payments_ck_method  | CHECK       | CHECK ((pay_method = ANY (ARRAY['наличные'::text, 'карта'::text, 'перевод'::text])))
 payments           | payments_ck_sum     | CHECK       | CHECK ((pay_sum > (0)::numeric))
 passages           | passages_ck_conf    | CHECK       | CHECK (((pass_confidence >= (0)::numeric) AND (pass_confidence <= (1)::numeric)))
 passages           | passages_ck_dir     | CHECK       | CHECK (((pass_direction)::text = ANY ((ARRAY['IN'::character varying, 'OUT'::character varying])::text[])))
 employees          | employees_fk        | FOREIGN KEY | FOREIGN KEY (emp_chief_id) REFERENCES employees(emp_id) ON UPDATE CASCADE ON DELETE SET NULL
 vehicles           | vehicles_fk1        | FOREIGN KEY | FOREIGN KEY (veh_client_id) REFERENCES clients(cl_id) ON UPDATE CASCADE ON DELETE CASCADE
 vehicles           | vehicles_fk2        | FOREIGN KEY | FOREIGN KEY (veh_cat_id) REFERENCES vehicle_categories(cat_id) ON UPDATE CASCADE ON DELETE CASCADE
 places             | places_fk           | FOREIGN KEY | FOREIGN KEY (pl_cat_id) REFERENCES vehicle_categories(cat_id) ON UPDATE CASCADE ON DELETE CASCADE
 tariffs            | tariffs_fk          | FOREIGN KEY | FOREIGN KEY (tar_cat_id) REFERENCES vehicle_categories(cat_id) ON UPDATE CASCADE ON DELETE CASCADE
 contracts          | contracts_fk1       | FOREIGN KEY | FOREIGN KEY (contr_client_id) REFERENCES clients(cl_id) ON UPDATE CASCADE ON DELETE CASCADE
 contracts          | contracts_fk2       | FOREIGN KEY | FOREIGN KEY (contr_veh_id) REFERENCES vehicles(veh_id) ON UPDATE CASCADE ON DELETE CASCADE
 contracts          | contracts_fk3       | FOREIGN KEY | FOREIGN KEY (contr_place_id) REFERENCES places(pl_id) ON UPDATE CASCADE ON DELETE CASCADE
 contracts          | contracts_fk4       | FOREIGN KEY | FOREIGN KEY (contr_tariff_id) REFERENCES tariffs(tar_id) ON UPDATE CASCADE ON DELETE CASCADE
 contracts          | contracts_fk5       | FOREIGN KEY | FOREIGN KEY (contr_emp_id) REFERENCES employees(emp_id) ON UPDATE CASCADE ON DELETE CASCADE
 payments           | payments_fk1        | FOREIGN KEY | FOREIGN KEY (pay_contr_id) REFERENCES contracts(contr_id) ON UPDATE CASCADE ON DELETE CASCADE
 payments           | payments_fk2        | FOREIGN KEY | FOREIGN KEY (pay_emp_id) REFERENCES employees(emp_id) ON UPDATE CASCADE ON DELETE CASCADE
 passages           | passages_fk1        | FOREIGN KEY | FOREIGN KEY (pass_veh_id) REFERENCES vehicles(veh_id) ON UPDATE CASCADE ON DELETE SET NULL
 passages           | passages_fk2        | FOREIGN KEY | FOREIGN KEY (pass_contr_id) REFERENCES contracts(contr_id) ON UPDATE CASCADE ON DELETE SET NULL
 passages           | passages_fk3        | FOREIGN KEY | FOREIGN KEY (pass_place_id) REFERENCES places(pl_id) ON UPDATE CASCADE ON DELETE SET NULL
 vehicle_categories | categories_pk       | PRIMARY KEY | PRIMARY KEY (cat_id)
 clients            | clients_pk          | PRIMARY KEY | PRIMARY KEY (cl_id)
 employees          | employees_pk        | PRIMARY KEY | PRIMARY KEY (emp_id)
 vehicles           | vehicles_pk         | PRIMARY KEY | PRIMARY KEY (veh_id)
 places             | places_pk           | PRIMARY KEY | PRIMARY KEY (pl_id)
 tariffs            | tariffs_pk          | PRIMARY KEY | PRIMARY KEY (tar_id)
 contracts          | contracts_pk        | PRIMARY KEY | PRIMARY KEY (contr_id)
 payments           | payments_pk         | PRIMARY KEY | PRIMARY KEY (pay_id)
 passages           | passages_pk         | PRIMARY KEY | PRIMARY KEY (pass_id)
 vehicle_categories | categories_uk       | UNIQUE      | UNIQUE (cat_name)
 clients            | clients_uk          | UNIQUE      | UNIQUE (cl_doc)
 vehicles           | vehicles_uk         | UNIQUE      | UNIQUE (veh_plate)
 places             | places_uk           | UNIQUE      | UNIQUE (pl_sector, pl_number)
 tariffs            | tariffs_uk          | UNIQUE      | UNIQUE (tar_name, tar_cat_id, tar_date_from)
 contracts          | contracts_uk        | UNIQUE      | UNIQUE (contr_number)
 payments           | payments_uk         | UNIQUE      | UNIQUE (pay_receipt_no)
 passages           | passages_uk         | UNIQUE      | UNIQUE (pass_plate_raw, pass_time, pass_direction)
(51 ������)

SELECT CASE contype WHEN 'p' THEN 'PRIMARY KEY (целостность по сущностям)'
                    WHEN 'u' THEN 'UNIQUE (потенциальные ключи)'
                    WHEN 'c' THEN 'CHECK (семантическая целостность)'
                    WHEN 'f' THEN 'FOREIGN KEY (ссылочная целостность)'
                    WHEN 'x' THEN 'EXCLUDE (бизнес-правила)' END AS "Вид ограничения",
       count(*) AS "Количество"
FROM   pg_constraint
WHERE  connamespace = 'public'::regnamespace
GROUP  BY contype
ORDER  BY 2 DESC;
            Вид ограничения             | Количество 
----------------------------------------+------------
 CHECK (семантическая целостность)      |         19
 FOREIGN KEY (ссылочная целостность)    |         15
 PRIMARY KEY (целостность по сущностям) |          9
 UNIQUE (потенциальные ключи)           |          8
(4 ������)

SELECT conname             AS "Внешний ключ",
       conrelid::regclass  AS "Дочерняя таблица",
       confrelid::regclass AS "Родительская таблица",
       CASE confdeltype WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT'
                        WHEN 'c' THEN 'CASCADE'   WHEN 'n' THEN 'SET NULL'
                        WHEN 'd' THEN 'SET DEFAULT' END AS "ON DELETE",
       CASE confupdtype WHEN 'a' THEN 'NO ACTION' WHEN 'r' THEN 'RESTRICT'
                        WHEN 'c' THEN 'CASCADE'   WHEN 'n' THEN 'SET NULL'
                        WHEN 'd' THEN 'SET DEFAULT' END AS "ON UPDATE"
FROM   pg_constraint
WHERE  contype = 'f' AND connamespace = 'public'::regnamespace
ORDER  BY 2, 1;
 Внешний ключ  | Дочерняя таблица | Родительская таблица | ON DELETE | ON UPDATE 
---------------+------------------+----------------------+-----------+-----------
 employees_fk  | employees        | employees            | SET NULL  | CASCADE
 vehicles_fk1  | vehicles         | clients              | CASCADE   | CASCADE
 vehicles_fk2  | vehicles         | vehicle_categories   | CASCADE   | CASCADE
 places_fk     | places           | vehicle_categories   | CASCADE   | CASCADE
 tariffs_fk    | tariffs          | vehicle_categories   | CASCADE   | CASCADE
 contracts_fk1 | contracts        | clients              | CASCADE   | CASCADE
 contracts_fk2 | contracts        | vehicles             | CASCADE   | CASCADE
 contracts_fk3 | contracts        | places               | CASCADE   | CASCADE
 contracts_fk4 | contracts        | tariffs              | CASCADE   | CASCADE
 contracts_fk5 | contracts        | employees            | CASCADE   | CASCADE
 payments_fk1  | payments         | contracts            | CASCADE   | CASCADE
 payments_fk2  | payments         | employees            | CASCADE   | CASCADE
 passages_fk1  | passages         | vehicles             | SET NULL  | CASCADE
 passages_fk2  | passages         | contracts            | SET NULL  | CASCADE
 passages_fk3  | passages         | places               | SET NULL  | CASCADE
